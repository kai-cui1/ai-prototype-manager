# ============================================
# ai-prototype-manager 环境配置（唯一配置源）
# 前后端均从此文件读取，禁止在代码中硬编码端口/地址
# ============================================

# --- Database ---
DATABASE_URL=postgresql://apm_dev:apm_dev_secret@localhost:5432/apm_prototype

# --- API Backend ---
API_PORT=13180
API_HOST=0.0.0.0

# --- Web Frontend (Vite dev server) ---
WEB_PORT=13181

# --- Frontend API 地址（VITE_ 前缀才会暴露到浏览器端）---
# 开发环境留空 → 使用相对路径 /api/v1，由 Vite proxy 转发到后端
VITE_API_BASE_URL=
